# Ignore build artifacts and dependencies
node_modules/
dist/
coverage/
.mjolnir/logs/
# Machine-local state (audit R-3): counters and milestones are per-repo,
# per-machine — never committed. .mjolnir/baseline.json is deliberately
# NOT ignored: it is meant to be committed (the mjolnir.yml workflow
# fetches it from the base branch).
.mjolnir/stats.json

# FP corpus audit — cloned real-world repos, never committed
tests/corpus/.cache/

# VitePress documentation site
site/.vitepress/dist/
site/.vitepress/cache/
# Rule catalog pages — generated from docs/rules/ at build time by
# site/scripts/gen-rules.mjs; docs/rules/ is the committed source.
site/rules/

# Environment
.env
.env.*

# Generated by running the README demo (examples/demo-repo)
examples/demo-repo/test-results/FLAKY.md
examples/demo-repo/test-results/TRIAGE.md

# Generated build/scan artifacts
mjolnir-badge.json
self-scan.json


# Scratch/probe files (debug artifacts, never committed)
scratch/
package/

# Saved HTML artifact exports dropped into .planning for reference
.planning/*.html
.planning/*_files/
