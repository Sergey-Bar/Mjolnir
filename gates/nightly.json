{
  "schemaVersion": 1,

  "tier": "nightly",

  "description": "Every gate that runs on a schedule, and the outermost tier. A superset of release by construction. This is where the twelve `scripts/v6` gates live: they are real gates with real exit codes that no workflow ran, and they cannot live anywhere else. Corpus regression is network-bound and is not part of `npm test`; `ecosystem:gaps` exits 3 on BLOCKED (absent corpus cache) and only reaches PASS once the cache exists, which is why the corpus job and the gate jobs share this file. The stress harness lives in stress.yml and is listed here so the tier is one reviewable set rather than a set plus an exception.",

  "runsOn": ["schedule", "workflow_dispatch"],

  "workflows": [
    ".github/workflows/corpus-audit.yml",

    ".github/workflows/stress.yml",

    ".github/workflows/fuzz.yml"
  ],

  "alsoRunsIn": [
    ".github/workflows/release-smoke.yml",

    ".github/workflows/sarif-code-scanning.yml"
  ],

  "gates": [
    {
      "id": "certification-surface",
      "command": "npm run check-certification-surface"
    },
    {
      "id": "certification-matrix",
      "command": "npm run docs:certification-matrix:check"
    },
    {
      "id": "certification-gaps",
      "command": "npm run docs:certification-gaps:check"
    },
    { "id": "build", "command": "npm run build" },

    { "id": "typecheck", "command": "npm run typecheck" },

    { "id": "lint", "command": "npm run lint" },

    { "id": "version-check", "command": "npm run check-version" },

    { "id": "brand-doctor", "command": "npm run brand:doctor" },

    {
      "id": "brand-doctor-selftest",

      "command": "npm run brand:doctor:selftest"
    },

    { "id": "brand-fonts", "command": "npm run brand:fonts:check" },

    { "id": "coverage", "command": "npm run test:coverage:ci" },

    { "id": "coverage-ratchet", "command": "npm run coverage:ratchet" },

    { "id": "property", "command": "npm run test:property" },

    { "id": "audit", "command": "npm run audit:ci" },

    { "id": "site-doctor", "command": "npm run doctor" },

    { "id": "ci-standard", "command": "npm run ci:standard" },

    { "id": "self-scan", "command": "node dist/cli.mjs src --json" },

    { "id": "docs-regen", "command": "npm run docs:regen" },

    { "id": "fuzz", "command": "npm run test:fuzz" },

    { "id": "certify", "command": "npm run ci-local" },

    { "id": "candidate-readiness", "command": "npm run candidate:readiness" },
    { "id": "entry-points", "command": "npm run entry-points:check" },
    { "id": "gate-tiers", "command": "npm run gates:check" },

    { "id": "corpus-regression", "command": "npm run corpus:audit" },

    {
      "id": "build-determinism",

      "command": "npm run verify-build-determinism"
    },

    { "id": "corpus-resample", "command": "npm run corpus:audit --resample" },

    { "id": "gate:registry", "command": "npm run registry:check" },

    { "id": "gate:rule-quality", "command": "npm run rules:quality:check" },

    { "id": "gate:claims-prose", "command": "npm run claims:prose:strict" },

    { "id": "gate:claim-budget", "command": "npm run claim:budget" },

    { "id": "gate:ecosystem-census", "command": "npm run ecosystem:census" },

    { "id": "gate:ecosystem-gaps", "command": "npm run ecosystem:gaps" },

    { "id": "gate:thresholds-parity", "command": "npm run thresholds:parity" },

    {
      "id": "gate:coverage-exemptions",

      "command": "npm run coverage:exemptions"
    },

    { "id": "gate:verbs-budget", "command": "npm run verbs:budget" },

    { "id": "gate:tiers", "command": "node scripts/check-gate-tiers.mjs" },

    {
      "id": "scripts-unimported",
      "command": "npm run check-unimported-modules"
    },

    { "id": "qa-ir-parity", "command": "npm run qa-ir:parity" },

    { "id": "stress-soak", "command": "node tests/stress/soak.mjs" },

    {
      "id": "stress-concurrent",
      "command": "node tests/stress/concurrent.mjs"
    },

    { "id": "cli-contract", "command": "npm run check-cli-contract" },
    { "id": "detector-hashes", "command": "npm run check-detector-hashes" },

    { "id": "workflow-scripts", "command": "npm run workflow:scripts" },

    { "id": "config-consumers", "command": "npm run config:consumers" },

    { "id": "script-reachability", "command": "npm run scripts:reachable" },

    { "id": "quad-verified", "command": "npm run check-fixture-quad" },

    { "id": "promotion-ratchet", "command": "npm run rules:promotion:check" },

    { "id": "provenance-drift", "command": "npm run docs:provenance-drift" },

    { "id": "roadmap-backlinks", "command": "npm run docs:roadmap:backlinks" },

    { "id": "claim-integrity", "command": "npm run gates:claim-integrity" }
  ]
}
