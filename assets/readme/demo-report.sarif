            "evidenceLevel": "E2"
          }
        },
        {
          "ruleId": "QA-CI-001",
          "level": "note",
          "message": {
            "text": "Job `security-scan` runs a verification gate under `continue-on-error: true`. — This job can fail every day and CI will still show green. The checkmark on this workflow cannot be trusted. Fix: Remove continue-on-error, or scope it to individual non-blocking steps only."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 27,
