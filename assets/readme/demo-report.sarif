        {
          "ruleId": "QA-PW-122",
          "level": "warning",
          "message": {
            "text": "playwright.config has no `trace` capture setting. — A test that fails once and passes on retry is exactly the case you'll need evidence for later — with no trace, the flake is uninvestigable. Fix: Add `use: { trace: 'on-first-retry' }` to the config."
          },
          "locations": [
            {
              "physicalLocation": {
