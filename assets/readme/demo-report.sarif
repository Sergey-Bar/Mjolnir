          "properties": {
            "severity": "info",
            "confidence": "high",
            "qaImpact": "FALSE-GREEN",
            "evidenceLevel": "E0"
          }
        },
        {
          "ruleId": "QA-PW-145",
          "level": "note",
          "message": {
            "text": "UI-interacting spec file contains no accessibility assertions. — Suites that drive the UI but never assert accessibility let WCAG regressions through every PR; catching them at the point of interaction is far cheaper than a retrofit audit. Fix: Add `@axe-core/playwright` with `expect(await new AxeBuilder({ page }).analyze()).toHaveNoViolations()` on key pages, or snapshot aria snapshots."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "e2e/checkout.spec.ts"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "info",
            "confidence": "low",
            "qaImpact": "HYGIENE",
            "evidenceLevel": "E0"
          }
        },
        {
          "ruleId": "QA-PW-103",
          "level": "note",
          "message": {
            "text": "`goto(\"/checkout\")` without an explicit timeout. — Magic-default timeouts make failures opaque (was it slow, or broken?) and never encode the product's actual performance budget. Fix: Pass `{ timeout: <budget-ms> }` matching your performance SLO, or set actionTimeout/navigationTimeout deliberately in config."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "e2e/checkout.spec.ts"
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 14
