{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Mjölnir",
          "informationUri": "https://github.com/Sergey-Bar/Mjolnir",
          "version": "0.5.0",
          "rules": [
            {
              "id": "QA-CI-009",
              "shortDescription": {
                "text": "Job `test` pipes the test command into another tool without `set -o pipefail`."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            },
            {
              "id": "QA-CI-010",
              "shortDescription": {
                "text": "Job `deploy-smoke` runs tests but its `if:` condition skips it on pull requests."
              },
              "properties": {
                "falsePositiveRisk": "medium"
              }
            },
            {
              "id": "QA-CI-001",
              "shortDescription": {
                "text": "Job `security-scan` runs a verification gate under `continue-on-error: true`."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            },
            {
              "id": "QA-PW-145",
              "shortDescription": {
                "text": "UI-interacting spec file contains no accessibility assertions."
              },
              "properties": {
                "falsePositiveRisk": "high"
              }
            },
            {
              "id": "QA-PW-103",
              "shortDescription": {
                "text": "`goto(\"/checkout\")` without an explicit timeout."
              },
              "properties": {
                "falsePositiveRisk": "high"
              }
            },
            {
              "id": "QA-PW-004",
              "shortDescription": {
                "text": "Brittle multi-class CSS selector: `locator(\".btn.btn-primary > div:nth-child(2)\""
              },
              "properties": {
                "falsePositiveRisk": "medium"
              }
            },
            {
              "id": "QA-PW-101",
              "shortDescription": {
                "text": "`waitForTimeout()` hard sleep."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            },
            {
              "id": "QA-TEST-002",
              "shortDescription": {
                "text": "Skipped test without justification: `test.skip(`."
              },
              "properties": {
                "falsePositiveRisk": "medium"
              }
            },
            {
              "id": "QA-PW-123",
              "shortDescription": {
                "text": "Hardcoded URL: `goto(\"https://staging.example.com/login\"`."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            },
            {
              "id": "QA-PW-118",
              "shortDescription": {
                "text": "`waitForLoadState('networkidle')` used."
              },
              "properties": {
                "falsePositiveRisk": "high"
              }
            },
            {
              "id": "QA-PW-122",
              "shortDescription": {
                "text": "playwright.config has no `trace` capture setting."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            },
            {
              "id": "QA-PW-143",
              "shortDescription": {
                "text": "playwright.config captures neither screenshots nor video on failure."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            },
            {
              "id": "QA-PW-141",
              "shortDescription": {
                "text": "retries: undefined with no visible flake-triage loop."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            },
            {
              "id": "QA-PY-003",
              "shortDescription": {
                "text": "Test `test_checkout_endpoint_responds` contains no assertions."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            },
            {
              "id": "QA-PY-005",
              "shortDescription": {
                "text": "Hard sleep: `time.sleep(2…`."
              },
              "properties": {
                "falsePositiveRisk": "low"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "QA-CI-009",
          "level": "error",
          "message": {
            "text": "Job `test` pipes the test command into another tool without `set -o pipefail`. — In a shell pipeline only the last command's exit code counts — a failing test run is masked by the downstream tool succeeding. Fix: Add `shell: bash` with `set -o pipefail`, or split into two steps so the test command's exit code is preserved."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "error",
            "confidence": "high",
            "qaImpact": "FALSE-GREEN",
            "evidenceLevel": "E2"
          }
        },
        {
          "ruleId": "QA-CI-009",
          "level": "error",
          "message": {
            "text": "Job `deploy-smoke` sequences commands with `; ` after the test command — the test result does not fail the step. — With `;` sequencing the step's exit status comes from the last command only, so failed tests still yield a green checkmark. Fix: Chain with `&&` instead of `;` so a test failure fails the step."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "error",
            "confidence": "medium",
            "qaImpact": "FALSE-GREEN",
            "evidenceLevel": "E2"
          }
        },
        {
          "ruleId": "QA-CI-010",
          "level": "note",
          "message": {
            "text": "Job `deploy-smoke` runs tests but its `if:` condition skips it on pull requests. — If this job is a required check, PRs can satisfy it while zero tests executed — the green checkmark verifies nothing. Fix: Remove the skip-on-PR condition, or split into a dedicated PR test job and require THAT one in branch protection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 21,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "info",
            "confidence": "medium",
            "qaImpact": "FALSE-GREEN",
            "evidenceLevel": "E0"
          }
        },
        {
          "ruleId": "QA-CI-009",
          "level": "error",
          "message": {
            "text": "Job `deploy-smoke` pipes the test command into another tool without `set -o pipefail`. — In a shell pipeline only the last command's exit code counts — a failing test run is masked by the downstream tool succeeding. Fix: Add `shell: bash` with `set -o pipefail`, or split into two steps so the test command's exit code is preserved."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 26,
