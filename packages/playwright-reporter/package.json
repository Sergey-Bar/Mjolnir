{
  "name": "@qa-doctor/playwright-reporter",
  "version": "0.1.0",
  "description": "Official Playwright JSON reporter for QA Doctor — emits the machine-readable report that `qa-doctor forensics`, `triage`, and `pw-report` ingest.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "qa-doctor",
    "playwright",
    "reporter",
    "flaky-tests",
    "test-forensics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergey-Bar/QA-Doctor.git",
    "directory": "qa-doctor/packages/playwright-reporter"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist"
  },
  "engines": {
    "node": ">=20"
  }
}
