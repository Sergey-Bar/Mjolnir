{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/node_modules/**",
    "tests/fixtures/**",
    "tests/golden/repo/**",
    "tests/corpus/.cache*/**",
    "tests/corpus/positive-fixtures/**",
    "tests/corpus/negative-fixtures/**",
    "packages/*/example.config.ts"
  ]
}
