{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Sergey-Bar/Mjolnir/schemas/v6/ecosystem-census.schema.json",
  "title": "Mjölnir QA Ecosystem Census",
  "description": "The versioned, owned, dated authority on what exists in the QA ecosystem (Law 8, ADR 0010). `entries` is the base registry and is a function of the checkout alone; `stalenessDemotions` is field-observed and depends on whether the corpus cache is present, which is why the two are separate sections. `state` (ecosystem coverage) and `maturity` (proof of our handling) are orthogonal axes: neither is derived from the other.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifact",
    "censusId",
    "observedAt",
    "baseSha",
    "counts",
    "entries",
    "stalenessDemotions",
    "effectiveEntries"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifact": { "const": "ecosystem-census" },
    "generatedBy": { "type": "string" },
    "censusId": { "const": "mjolnir-ecosystem-census" },
    "observedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Review date. The git commit date, never a clock stamp, so the artifact is byte-stable for a given commit."
    },
    "baseSha": { "type": "string" },
    "counts": { "type": "object" },
    "stalenessDemotions": {
      "type": "array",
      "description": "Entries auto-demoted SUPPORTED → TARGET because the corpus runs an upstream major the adapter was never validated against (ADR 0010 rule 3).",
      "items": {
        "type": "object",
        "required": [
          "entryId",
          "handledUpstreamMajors",
          "observedMajor",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "entryId": { "type": "string", "pattern": "^ec\\." },
          "handledUpstreamMajors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "observedMajor": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
    "effectiveEntries": {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" },
      "description": "The entries as they stand after staleness demotions apply."
    }
  },
  "definitions": {
    "maturity": {
      "type": "string",
      "enum": [
        "M0_UNKNOWN",
        "M1_DECLARED",
        "M2_IMPLEMENTED",
        "M3_FIXTURE_VERIFIED",
        "M4_CORPUS_VERIFIED",
        "M5_FIELD_PROVEN"
      ],
      "description": "The capability maturity axis (ADR 0001). `L0`–`L5` is the finding trust level and is never a maturity value; a schema that put it here would be the collision A1 was written to prevent."
    },
    "state": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "TARGET",
        "DEPRECATED",
        "NOT_APPLICABLE",
        "UNRECOGNIZED"
      ],
      "description": "Ecosystem coverage, orthogonal to maturity. `UNRECOGNIZED` is a discovery output and MUST NOT appear in `entries`: it belongs in the generated gap report, so the curated registry cannot contain its own findings."
    },
    "category": {
      "type": "string",
      "enum": [
        "language",
        "test-framework",
        "test-runner",
        "bdd-spec-dsl",
        "api-contract-testing",
        "component-e2e",
        "mobile-testing",
        "load-performance",
        "test-management",
        "accessibility-scanner",
        "security-scanner",
        "visual-regression",
        "report-artifact-format",
        "ci-cd-provider",
        "iac-container",
        "browser-device-matrix",
        "mutation-testing",
        "observability"
      ]
    },
    "signal": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "manifest-file" },
            "path": { "type": "string" }
          },
          "required": ["path"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "config-file" },
            "path": { "type": "string" }
          },
          "required": ["path"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "workflow-dir" },
            "path": { "type": "string" }
          },
          "required": ["path"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "extension" },
            "glob": { "type": "string" }
          },
          "required": ["glob"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "dependency" },
            "ecosystem": {
              "type": "string",
              "description": "`any` opts out of the ecosystem check, for a distribution name that is genuinely cross-ecosystem."
            },
            "name": { "type": "string" }
          },
          "required": ["ecosystem", "name"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "script-command" },
            "ecosystem": { "type": "string" },
            "command": { "type": "string" }
          },
          "required": ["ecosystem", "command"],
          "additionalProperties": false
        }
      ]
    },
    "nextLevelGap": {
      "type": "object",
      "description": "Required at every level below M5 and forbidden at M5 (ADR 0001 / D1).",
      "required": ["target", "missing", "owner", "revisitTrigger"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/definitions/maturity" },
        "missing": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["unassigned", "unowned", "tbd", "unknown", "none", "n/a"]
          }
        },
        "revisitTrigger": {
          "type": "string",
          "minLength": 1,
          "description": "Auto-demotion depends on this, so it is not optional."
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "state",
        "owner",
        "observedAt",
        "signals",
        "adapter",
        "blocksAxes",
        "upstreamPackages",
        "handledUpstreamMajors",
        "revisitTrigger",
        "maturity",
        "nextLevelGap"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ec\\.[a-z0-9-]+\\.[a-z0-9-]+$",
          "description": "Canonical census id. Never a rule id — the `QA-*` namespace is frozen (ADR 0003)."
        },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/definitions/category" },
        "state": { "$ref": "#/definitions/state" },
        "owner": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "upstream": { "type": "string" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/signal" },
          "description": "An entry with no signal is invisible to discovery, so a SUPPORTED claim on it is unfalsifiable."
        },
        "adapter": {
          "type": ["string", "null"],
          "description": "Required non-null when `state` is `SUPPORTED`."
        },
        "blocksAxes": { "type": "array", "items": { "type": "string" } },
        "successor": { "type": ["string", "null"] },
        "removalDate": { "type": ["string", "null"] },
        "notApplicableReason": { "type": ["string", "null"] },
        "upstreamPackages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ecosystem", "name"],
            "additionalProperties": false,
            "properties": {
              "ecosystem": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "handledUpstreamMajors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "revisitTrigger": { "type": "string", "minLength": 1 },
        "maturity": { "$ref": "#/definitions/maturity" },
        "nextLevelGap": {
          "oneOf": [
            { "$ref": "#/definitions/nextLevelGap" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "SUPPORTED" } } },
          "then": { "properties": { "adapter": { "type": "string" } } }
        },
        {
          "if": { "properties": { "state": { "const": "DEPRECATED" } } },
          "then": {
            "required": ["successor", "removalDate"],
            "properties": {
              "successor": { "type": "string" },
              "removalDate": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "NOT_APPLICABLE" } } },
          "then": {
            "properties": { "notApplicableReason": { "type": "string" } }
          }
        },
        {
          "if": { "properties": { "state": { "const": "TARGET" } } },
          "then": {
            "properties": {
              "nextLevelGap": { "$ref": "#/definitions/nextLevelGap" }
            }
          }
        }
      ]
    }
  }
}
