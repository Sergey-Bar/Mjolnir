{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m26-gap-ledger-record.schema.json",
  "title": "M26 gap ledger JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gap_id",
    "source_url_or_command",
    "source_kind",
    "severity",
    "category",
    "affected_surface",
    "affected_version_or_milestone",
    "reproduction_or_proof",
    "expected_behavior",
    "actual_behavior",
    "user_or_security_impact",
    "owner",
    "target_train",
    "status",
    "fix_design",
    "regression_test",
    "revalidation_command",
    "evidence_artifact",
    "expiry_or_revisit_trigger",
    "rollback_artifact",
    "dependencies",
    "closure_evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gap_id": { "type": "string", "pattern": "^GAP-[A-Z0-9][A-Z0-9._-]*$" },
    "source_url_or_command": { "type": "string", "minLength": 1 },
    "source_kind": { "type": "string", "minLength": 1 },
    "severity": {
      "enum": ["release-blocker", "high", "medium", "low", "debt"]
    },
    "category": { "type": "string", "minLength": 1 },
    "affected_surface": { "type": "string", "minLength": 1 },
    "affected_version_or_milestone": { "type": "string", "minLength": 1 },
    "reproduction_or_proof": { "type": "string", "minLength": 1 },
    "expected_behavior": { "type": "string", "minLength": 1 },
    "actual_behavior": { "type": "string", "minLength": 1 },
    "user_or_security_impact": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "target_train": {
      "type": "string",
      "pattern": "^M(?:[0-9]|[1-4][0-9]|50)$"
    },
    "status": {
      "enum": [
        "open",
        "accepted",
        "fix-in-progress",
        "fixed",
        "regression",
        "deferred",
        "not-applicable"
      ]
    },
    "fix_design": { "type": "string", "minLength": 1 },
    "regression_test": { "type": "string", "minLength": 1 },
    "revalidation_command": { "type": "string", "minLength": 1 },
    "evidence_artifact": { "type": "string", "minLength": 1 },
    "expiry_or_revisit_trigger": { "type": "string", "minLength": 1 },
    "rollback_artifact": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "disposition_reason": { "type": "string", "minLength": 1 },
    "release_consequence": { "type": "string", "minLength": 1 },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^GAP-[A-Z0-9][A-Z0-9._-]*$"
    },
    "superseded_by": {
      "type": ["string", "null"],
      "pattern": "^GAP-[A-Z0-9][A-Z0-9._-]*$"
    },
    "closure_evidence": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate",
            "observed_at",
            "command",
            "result",
            "artifacts"
          ],
          "properties": {
            "candidate": { "type": "string", "minLength": 1 },
            "observed_at": { "type": "string", "format": "date-time" },
            "command": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["fixed", "regression", "not-applicable"] }
        }
      },
      "then": { "properties": { "closure_evidence": { "type": "object" } } }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["accepted", "deferred"] } }
      },
      "then": { "required": ["disposition_reason", "release_consequence"] }
    }
  ]
}
