{
  "schemaVersion": 1,
  "flows": [
    {
      "id": "local-source-scan",
      "classification": "source",
      "origin": "developer-workspace",
      "destination": "local-process",
      "operator": "developer",
      "boundary": "workspace",
      "permittedPurpose": "Analyze the selected repository for QA findings",
      "protection": "local-only; bounded reads; no network",
      "accessRole": "local developer",
      "retention": "none beyond local artifacts",
      "deletion": "user-controlled workspace deletion",
      "failureBehavior": "Stop the affected read and report partial",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "local static analysis"
    },
    {
      "id": "test-metadata",
      "classification": "test",
      "origin": "local-source-scan",
      "destination": "local-report",
      "operator": "analyzer",
      "boundary": "workspace",
      "permittedPurpose": "Measure test discovery and analysis coverage",
      "protection": "schema validation and bounded counts",
      "accessRole": "local process",
      "retention": "report lifetime",
      "deletion": "artifact deletion",
      "failureBehavior": "Mark discovery partial",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "test inventory"
    },
    {
      "id": "finding-output",
      "classification": "finding",
      "origin": "local-process",
      "destination": "local-report",
      "operator": "analyzer",
      "boundary": "artifact",
      "permittedPurpose": "Communicate detected findings to the developer",
      "protection": "field validation and output escaping",
      "accessRole": "local developer",
      "retention": "report lifetime",
      "deletion": "artifact deletion",
      "failureBehavior": "Reject malformed finding",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "finding communication"
    },
    {
      "id": "evidence-output",
      "classification": "evidence",
      "origin": "local-process",
      "destination": "local-report",
      "operator": "analyzer",
      "boundary": "artifact",
      "permittedPurpose": "Show provenance and evidence coverage for findings",
      "protection": "redaction and provenance binding",
      "accessRole": "local developer",
      "retention": "report lifetime",
      "deletion": "artifact deletion",
      "failureBehavior": "Mark evidence incomplete",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "evidence review"
    },
    {
      "id": "prompt-processing",
      "classification": "prompt",
      "origin": "local-source",
      "destination": "local-process",
      "operator": "analyzer",
      "boundary": "workspace",
      "permittedPurpose": "Treat source text as untrusted input for static analysis",
      "protection": "prompt injection is not executable",
      "accessRole": "local process",
      "retention": "process lifetime",
      "deletion": "not retained",
      "failureBehavior": "Ignore executable instructions",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "local analysis"
    },
    {
      "id": "local-log",
      "classification": "log",
      "origin": "local-process",
      "destination": "local-console",
      "operator": "analyzer",
      "boundary": "workspace",
      "permittedPurpose": "Report progress and errors to the operator",
      "protection": "secret redaction and bounded messages",
      "accessRole": "local developer",
      "retention": "console lifetime",
      "deletion": "not persisted by default",
      "failureBehavior": "Redact and continue or report an error",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "operator feedback"
    },
    {
      "id": "report-artifact",
      "classification": "artifact",
      "origin": "local-process",
      "destination": "local-artifact",
      "operator": "developer",
      "boundary": "artifact",
      "permittedPurpose": "Persist a machine and human-readable scan result",
      "protection": "atomic contained write; bounded schema",
      "accessRole": "local developer",
      "retention": "user-controlled",
      "deletion": "user-controlled",
      "failureBehavior": "Do not replace a valid artifact",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "report persistence"
    },
    {
      "id": "artifact-backup",
      "classification": "backup",
      "origin": "local-artifact",
      "destination": "user-managed-backup",
      "operator": "developer",
      "boundary": "artifact",
      "permittedPurpose": "Developer-requested backup of a report",
      "protection": "explicit user action; no default upload",
      "accessRole": "developer",
      "retention": "user-controlled",
      "deletion": "user-controlled",
      "failureBehavior": "Do not claim backup success",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "user backup"
    },
    {
      "id": "scan-metadata",
      "classification": "metadata",
      "origin": "local-process",
      "destination": "local-report",
      "operator": "analyzer",
      "boundary": "workspace",
      "permittedPurpose": "Bind a report to source, rules, and run identity",
      "protection": "candidate-bound fingerprint and explicit unknown states",
      "accessRole": "local developer",
      "retention": "report lifetime",
      "deletion": "artifact deletion",
      "failureBehavior": "Mark identity incomplete",
      "network": false,
      "consent": "not-required",
      "approvedPurpose": "run provenance"
    },
    {
      "id": "hosted-ai-review",
      "classification": "source",
      "origin": "developer-workspace",
      "destination": "external-hosted-service",
      "operator": "developer",
      "boundary": "network",
      "permittedPurpose": "Optional hosted AI review after explicit opt-in",
      "protection": "explicit consent; approved purpose; no default network",
      "accessRole": "developer-approved service",
      "retention": "service policy must be separately approved",
      "deletion": "service policy must be separately approved",
      "failureBehavior": "Do not transmit and report an explicit refusal",
      "network": true,
      "consent": "explicit",
      "approvedPurpose": "hosted AI review"
    }
  ]
}
