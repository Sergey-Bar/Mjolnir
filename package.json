{
  "name": "qa-doctor",
  "version": "0.3.7",
  "description": "The linter-grade quality scanner for QA engineers. Audits test suites and CI pipelines, reports a health score and prioritized findings.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "qa-doctor": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --dts --out-dir dist",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "golden:update": "tsx tests/golden/gen.ts",
    "corpus:audit": "tsx tests/corpus/audit.ts",
    "corpus:audit:update": "tsx tests/corpus/audit.ts --update",
    "self-scan": "node dist/cli.mjs .",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "qa",
    "testing",
    "ci",
    "github-actions",
    "jest",
    "vitest",
    "playwright",
    "code-quality",
    "linter",
    "static-analysis"
  ],
  "author": "QA Doctor Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qa-doctor/qa-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/qa-doctor/qa-doctor/issues"
  },
  "homepage": "https://github.com/qa-doctor/qa-doctor#readme",
  "dependencies": {
    "web-tree-sitter": "^0.26.13",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
