{
  "name": "mjolnir-qa",
  "version": "5.1.0",
  "publishedStable": "5.1.0",
  "description": "Mjölnir — the Verification Trust Engine for QA. Audits test suites and CI pipelines, reports a worthiness score and prioritized findings.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "mjolnir": "dist/cli.mjs",
    "mjolnir-qa": "dist/cli.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --dts --sourcemap --out-dir dist && tsdown src/mcp/stdio.ts --format esm --sourcemap --out-dir dist/mcp && npm run build --workspaces --if-present",
    "sentry:release": "node scripts/sentry-release.mjs",
    "dev": "tsx src/cli.ts",
    "mcp": "node dist/mcp/stdio.mjs",
    "test": "npm run skip:budget:init && vitest run --reporter=default --reporter=./scripts/vitest-skip-budget-reporter.mjs",
    "test:integration": "vitest run tests/integrations",
    "test:mcp:parity": "vitest run tests/mcp/parity.spec.ts",
    "frontier:contracts": "vitest run tests/contract/boundary-law.spec.ts tests/contract/exit-matrix.spec.ts tests/contract/json-contract.spec.ts tests/contract/machine-contract.spec.ts tests/contract/schema-contract.spec.ts tests/contract/vitest-suite-boundaries.spec.ts tests/contract/certification.spec.ts tests/contract/evidence-voting.spec.ts tests/contract/presentation-trust.spec.ts tests/contract/release-trust-contract.spec.ts tests/contract/saved-report-trust.spec.ts tests/contract/trust-ladder-single-source.spec.ts tests/contract/mcp-workspace-boundary.spec.ts tests/contract/privacy-network-isolation.spec.ts tests/contract/census-drift.spec.ts tests/contract/m26-support-matrix.spec.ts tests/contract/quarantine-ledger.spec.ts tests/contract/docs-consistency.spec.ts tests/contract/framework-capability-envelope.spec.ts tests/contract/pack-audit.spec.ts tests/contract/readme-commands.spec.ts tests/contract/semantic-integrity.spec.ts tests/contract/version-surface.spec.ts tests/contract/no-bare-process-exec.spec.ts tests/contract/coverage-exemption-truth.spec.ts tests/contract/deterministic-ordering.spec.ts tests/contract/deterministic-clock.spec.ts tests/contract/cli-workspace-boundary.spec.ts tests/contract/skip-budget.spec.ts tests/contract/no-uncounted-degradation.spec.ts tests/contract/single-error-helper.spec.ts",
    "test:release": "vitest run tests/release tests/commands/release-trust-arms.spec.ts",
    "bench:scan": "tsx scripts/bench-scan.ts .mjolnir --files 300",
    "test:stress": "vitest run --config vitest.stress.config.ts && node tests/stress/soak.mjs && node tests/stress/concurrent.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "npm run skip:budget:init && vitest run --coverage --maxWorkers=4 --testTimeout=120000 --hookTimeout=120000 --reporter=default --reporter=./scripts/vitest-skip-budget-reporter.mjs",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.mjs",
    "audit:ci": "npm audit --audit-level=moderate && npm audit --workspaces --audit-level=moderate",
    "enterprise:threat-model": "node scripts/enterprise/validate-threat-model.mjs --model enterprise/threat-model.json --data-flow enterprise/data-flows.json --strict",
    "claims:check": "node scripts/check-claim-registry.mjs",
    "report:honesty": "node scripts/check-report-honesty.mjs",
    "thresholds:parity": "node scripts/check-threshold-parity.mjs",
    "verbs:budget": "node scripts/check-verb-budget.mjs",
    "artifact:deterministic": "vitest run tests/contract/artifact-determinism.spec.ts",
    "claims:revalidate": "node scripts/revalidate-claims.mjs",
    "script:paths": "node scripts/check-script-paths.mjs",
    "lockfile:platforms": "node scripts/check-lockfile-platforms.mjs",
    "claims:prose": "tsx scripts/v6/check-claims-prose.ts",
    "claims:prose:strict": "tsx scripts/v6/check-claims-prose.ts --strict",
    "claim:budget": "tsx scripts/v6/check-claim-budget.ts",
    "claim:budget:init": "tsx scripts/v6/check-claim-budget.ts --init",
    "docs:ecosystem": "tsx scripts/v6/ecosystem-census.ts",
    "ecosystem:census": "tsx scripts/v6/check-ecosystem.ts census",
    "ecosystem:gaps": "tsx scripts/v6/check-ecosystem.ts gaps",
    "docs:v6-inventory": "tsx scripts/v6/generate-inventory.ts",
    "docs:capability": "tsx scripts/generate-capability-matrix.ts",
    "docs:registry": "tsx scripts/v6/generate-capability.ts",
    "registry:check": "tsx scripts/v6/check-capability-registry.ts",
    "rules:quality:check": "tsx scripts/v6/check-rule-quality.ts",
    "workflow:scripts": "node scripts/check-workflow-scripts.mjs",
    "gates:check": "node scripts/check-gate-tiers.mjs",
    "exemptions:ceilings": "node scripts/check-exemption-ceilings.mjs",
    "docs:external-evidence": "tsx scripts/check-external-evidence.ts",
    "gates:disposition-source": "node scripts/check-disposition-source.mjs",
    "ledger:check": "tsx scripts/version-capability-ledger.ts --check",
    "ledger:write": "tsx scripts/version-capability-ledger.ts",
    "config:consumers": "node scripts/check-config-consumers.mjs",
    "scripts:reachable": "node scripts/check-script-reachability.mjs",
    "qa-ir:parity": "tsx scripts/v6/check-qa-ir-parity.ts",
    "v6:archive:check": "tsx scripts/v6/reconcile-archive.ts --check",
    "v6:archive:write": "tsx scripts/v6/reconcile-archive.ts --write",
    "issue-disposition:check": "tsx scripts/v6/check-issue-disposition.ts",
    "candidate:manifest:check": "node scripts/check-candidate-manifest.mjs",
    "candidate:manifest:update": "node scripts/update-candidate-manifest.mjs --write",
    "candidate:readiness": "node scripts/check-candidate-readiness.mjs",
    "candidate:decision:engineering": "node scripts/check-candidate-decision.mjs --stage engineering",
    "candidate:decision:release": "node scripts/check-candidate-decision.mjs --stage release",
    "coverage:exemptions": "node scripts/check-coverage-exemption-ledger.mjs",
    "check-unimported-modules": "node scripts/check-unimported-modules.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsx scripts/typecheck-fixtures.ts",
    "certify": "npm run certify:claims && npm run test:coverage && npm run doctor && npm run self-scan && npm run check-unimported-modules && npm run check-cli-contract && npm run check-fixture-quad && npm run certify:integrity && npm run skip:budget && npx vitest run tests/contract/",
    "certify:fast": "npm run build && npm run lint && npm run typecheck && npm run script:paths && npm run gates:check && npm run ledger:check && npm run gates:claim-integrity && npx vitest run tests/contract/",
    "certify:claims": "npm run build && npm run lint && npm run typecheck && npm run check-version && npm run enterprise:threat-model && npm run claims:check && npm run claims:revalidate && npm run report:honesty && npm run thresholds:parity && npm run script:paths && npm run gates:check && npm run ledger:check && npm run gates:claim-integrity",
    "certify:integrity": "npm run lockfile:platforms && npm run verbs:budget && npm run m26:integrity && npm run coverage:exemptions && npm run exemptions:ceilings && npm run docs:external-evidence && npm run gates:disposition-source && npm run candidate:manifest:check && npm run candidate:decision:engineering",
    "certify:ci": "npm run certify:claims && npm run certify:integrity && npm run test:coverage:ci && npm run skip:budget && npx vitest run tests/contract/",
    "docs:provenance-drift": "tsx scripts/check-provenance-artifacts.ts",
    "docs:core-readiness": "tsx scripts/core-readiness.ts",
    "check-fixture-quad": "tsx scripts/v6/check-fixture-quad.ts",
    "rules:promotion:check": "tsx scripts/v6/check-promotion-throughput.mjs",
    "docs:provenance-drift:fix": "npm run docs:registry && npm run docs:v6-inventory",
    "gates:claim-integrity": "npm run workflow:scripts && npm run config:consumers && npm run scripts:reachable && npm run check-unimported-modules && npm run check-cli-contract && npm run check-carve-manifest && npm run check-certification-surface && npm run docs:certification-matrix:check && npm run docs:certification-gaps:check && npm run check-concepts && npm run qa-ir:parity && npm run check-fixture-quad && npm run check-detector-hashes && npm run rules:promotion:check && npm run docs:provenance-drift && npm run docs:roadmap:backlinks",
    "ci-local": "npm run certify:ci && npm run test:property && npm run test:fuzz && npm run coverage:ratchet && npm run audit:ci && npm run brand:doctor && npm run brand:doctor:selftest && npm run brand:fonts:check && npm run doctor && npm run ci-local:parity",
    "verify:isolation": "node scripts/verify-remediation-isolation.mjs",
    "golden:update": "tsx tests/golden/gen.ts",
    "detector-hashes:update": "tsx scripts/generate-detector-hashes.ts",
    "check-detector-hashes": "tsx scripts/check-detector-hashes.ts",
    "corpus:audit": "tsx tests/corpus/audit.ts",
    "corpus:apply-verdicts": "tsx scripts/lib/apply-verdicts.ts",
    "corpus:verdict-context": "node scripts/verdict-context.mjs",
    "corpus:sample": "tsx scripts/corpus-sample.ts",
    "generate-fp-audit-table": "tsx scripts/generate-fp-audit-table.ts",
    "generate-rule-docs": "tsx scripts/generate-rule-docs.ts",
    "docs:counts": "tsx scripts/generate-counts.ts",
    "docs:depth-adjudication": "tsx scripts/generate-depth-adjudication.ts",
    "false-green:index": "tsx scripts/generate-false-green-index.ts",
    "docs:capabilities-playwright": "tsx scripts/generate-playwright-capabilities.ts",
    "docs:blast-radius": "tsx scripts/generate-blast-radius.ts",
    "docs:quarantine-ledger": "tsx scripts/generate-quarantine-ledger.ts",
    "docs:machine-contract": "tsx scripts/generate-machine-contract-doc.ts",
    "docs:hero": "tsx scripts/generate-readme-hero.ts",
    "docs:gauge": "tsx scripts/generate-readme-score-gauge.ts",
    "docs:readme-brand": "tsx scripts/generate-readme-brand.ts",
    "docs:formats": "tsx scripts/generate-site-formats.ts",
    "docs:forensics-samples": "tsx scripts/generate-forensics-samples.ts",
    "doctor": "node dist/cli.mjs doctor && npm --prefix site run doctor",
    "site:audit": "node site/scripts/audit-live.mjs",
    "site:lighthouse": "node site/scripts/lighthouse-run.mjs",
    "docs:demo": "tsx scripts/generate-readme-demo.ts",
    "docs:video:capture": "tsx scripts/video/write-scripts.ts",
    "docs:video:glyphs": "tsx scripts/video/check-glyphs.ts",
    "docs:video:render": "tsx scripts/video/render.ts --publish",
    "docs:video": "npm run docs:video:capture && npm run docs:video:render",
    "rules:census": "tsx scripts/print-rule-census.ts",
    "docs:roadmap:check": "tsx scripts/roadmap/check.ts",
    "docs:roadmap:backlinks": "tsx scripts/roadmap/check-backlinks.ts",
    "release:decision": "tsx scripts/release-decision.ts",
    "m26:audit": "tsx scripts/check-m26-ledgers.ts --stage readiness",
    "m26:integrity": "tsx scripts/check-m26-ledgers.ts --stage integrity",
    "m26:readiness": "npm run m26:audit && npm run candidate:readiness",
    "m26:github:sync": "node scripts/sync-m26-github.mjs",
    "m26:gaps:revalidate": "tsx scripts/revalidate-gaps.mjs",
    "version:surface:sync": "tsx scripts/sync-version-surface.ts",
    "check-version": "node scripts/check-version.mjs",
    "release:verify": "tsx scripts/release-verify.ts",
    "self-scan": "node dist/cli.mjs .",
    "ci:standard": "node scripts/check-ci-standard.mjs",
    "ci-local:parity": "node scripts/check-ci-local-parity.mjs",
    "test:property": "node scripts/check-property-runs.mjs && vitest run --config vitest.property.config.ts",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "docs:architecture": "tsx scripts/generate-readme-architecture.ts",
    "docs:how-it-works": "tsx scripts/readme-how-it-works.ts",
    "brand:tokens": "tsx scripts/generate-brand-tokens.ts",
    "brand:doctor": "node scripts/brand-doctor.mjs",
    "brand:pr-status": "tsx scripts/generate-pr-status-assets.ts",
    "brand:doctor:selftest": "node scripts/brand-doctor-selftest.mjs",
    "brand:fonts": "tsx scripts/vendor-fonts.ts",
    "brand:fonts:check": "tsx scripts/vendor-fonts.ts --check",
    "brand:marks": "tsx scripts/generate-brand-marks.ts",
    "brand:marks:update": "node scripts/update-mark-hashes.mjs",
    "docs:regen": "npm run generate-rule-docs && npm run generate-fp-audit-table && npm run docs:capability && npm run docs:counts && npm run docs:depth-adjudication && npm run docs:machine-contract && npm run docs:core-readiness && npm run brand:tokens && npm run golden:update && npm run docs:hero && npm run docs:architecture && npm run docs:how-it-works && npm run docs:demo && npm run docs:readme-brand && npm run detector-hashes:update",
    "docs:refresh": "node scripts/refresh-generated.mjs",
    "docs:refresh:check": "node scripts/refresh-generated.mjs --check",
    "skip:budget": "node scripts/check-skip-budget.mjs",
    "skip:budget:init": "node scripts/skip-budget-init.mjs",
    "verify-build-determinism": "node scripts/verify-build-determinism.mjs",
    "check-cli-contract": "node scripts/check-cli-contract.mjs",
    "generate-carve-manifest": "node scripts/v6/carve-manifest.mjs",
    "check-carve-manifest": "node scripts/v6/carve-manifest.mjs --check",
    "fix": "node dist/cli.mjs fix",
    "generate-concepts": "tsx scripts/generate-concepts.ts --write",
    "check-concepts": "tsx scripts/generate-concepts.ts",
    "check-certification-surface": "node scripts/check-certification-surface.mjs",
    "docs:certification-matrix": "tsx scripts/generate-certification-matrix.ts",
    "docs:certification-matrix:check": "tsx scripts/generate-certification-matrix.ts --check",
    "docs:certification-gaps": "tsx scripts/generate-certification-gaps.ts",
    "docs:certification-gaps:check": "tsx scripts/generate-certification-gaps.ts --check"
  },
  "keywords": [
    "qa",
    "testing",
    "ci",
    "github-actions",
    "jest",
    "vitest",
    "playwright",
    "code-quality",
    "linter",
    "static-analysis"
  ],
  "author": "Mjölnir Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergey-Bar/Mjolnir.git"
  },
  "bugs": {
    "url": "https://github.com/Sergey-Bar/Mjolnir/issues"
  },
  "homepage": "https://github.com/Sergey-Bar/Mjolnir#readme",
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "0.25.6",
    "yaml": "^2.5.0"
  },
  "peerDependencies": {
    "@sentry/node": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@sentry/node": "^11.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.3.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@vitest/coverage-istanbul@5.0.1": true
  }
}
