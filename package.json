{
  "name": "mjolnir-qa",
  "version": "4.0.0-rc.1",
  "publishedStable": "3.0.0",
  "description": "Mjölnir — the Verification Trust Engine for QA. Audits test suites and CI pipelines, reports a worthiness score and prioritized findings.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "mjolnir": "dist/cli.mjs",
    "mjolnir-qa": "dist/cli.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --dts --out-dir dist && tsdown src/mcp/stdio.ts --format esm --out-dir dist/mcp && npm run build --workspaces --if-present",
    "dev": "tsx src/cli.ts",
    "mcp": "node dist/mcp/stdio.mjs",
    "test": "vitest run",
    "test:integration": "vitest run tests/integrations",
    "test:mcp:parity": "vitest run tests/mcp/parity.spec.ts",
    "frontier:contracts": "vitest run tests/agent/decision-receipt.spec.ts tests/bench/m48-scale-operating-model.spec.ts tests/benchmark/m47-false-green-benchmark.spec.ts tests/contract/change-intelligence.spec.ts tests/contract/framework-capability-envelope.spec.ts tests/contract/m33-m34-governance-assurance.spec.ts tests/contract/m35-plugin-sdk.spec.ts tests/contract/m45-detector-lifecycle.spec.ts tests/contract/version-surface.spec.ts tests/engine/m38-challenge-contract.spec.ts tests/engine/m39-simulation-contract.spec.ts tests/engine/m40-language-expansion-contract.spec.ts tests/engine/m43-system-of-systems.spec.ts tests/engine/m44-historical-intelligence.spec.ts tests/engine/m49-experience-parity-contract.spec.ts tests/engine/runtime-evidence-graph.spec.ts tests/frameworks/provider-capability-contract.spec.ts tests/frameworks/universal-pack-contract.spec.ts tests/ledger/m26-validators.spec.ts tests/mutation/failure-sensitivity.spec.ts tests/qa/domain-model.spec.ts tests/research/m46-reproducible-research-lab-contract.spec.ts tests/roadmap/roadmap.spec.ts tests/rules/registry-census.spec.ts",
    "test:release": "vitest run tests/release tests/commands/release-trust-arms.spec.ts tests/commands/release-trust-branch.spec.ts",
    "bench:scan": "tsx scripts/bench-scan.ts .mjolnir --files 300",
    "test:stress": "vitest run --config vitest.stress.config.ts && node tests/stress/soak.mjs && node tests/stress/concurrent.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --maxWorkers=4 --testTimeout=120000 --hookTimeout=120000",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.mjs",
    "audit:ci": "npm audit --audit-level=moderate && npm audit --workspaces --audit-level=moderate",
    "enterprise:threat-model": "node scripts/enterprise/validate-threat-model.mjs --model enterprise/threat-model.json --data-flow enterprise/data-flows.json --strict",
    "claims:check": "node scripts/check-claim-registry.mjs",
    "claims:prose": "tsx scripts/v6/check-claims-prose.ts",
    "claims:prose:strict": "tsx scripts/v6/check-claims-prose.ts --strict",
    "claim:budget": "tsx scripts/v6/check-claim-budget.ts",
    "claim:budget:init": "tsx scripts/v6/check-claim-budget.ts --init",
    "docs:ecosystem": "tsx scripts/v6/ecosystem-census.ts",
    "ecosystem:census": "tsx scripts/v6/check-ecosystem.ts census",
    "ecosystem:gaps": "tsx scripts/v6/check-ecosystem.ts gaps",
    "docs:v6-inventory": "tsx scripts/v6/generate-inventory.ts",
    "docs:capability": "tsx scripts/generate-capability-matrix.ts",
    "docs:registry": "tsx scripts/v6/generate-capability.ts",
    "registry:check": "tsx scripts/v6/check-capability-registry.ts",
    "rules:quality:check": "tsx scripts/v6/check-rule-quality.ts",
    "qa-ir:parity": "tsx scripts/v6/check-qa-ir-parity.ts",
    "v6:archive:check": "tsx scripts/v6/reconcile-archive.ts",
    "issue-disposition:check": "tsx scripts/v6/check-issue-disposition.ts",
    "candidate:manifest:check": "node scripts/check-candidate-manifest.mjs",
    "candidate:manifest:update": "node scripts/update-candidate-manifest.mjs --write",
    "candidate:readiness": "node scripts/check-candidate-readiness.mjs",
    "candidate:decision:engineering": "node scripts/check-candidate-decision.mjs --stage engineering",
    "candidate:decision:release": "node scripts/check-candidate-decision.mjs --stage release",
    "coverage:exemptions": "node scripts/check-coverage-exemption-ledger.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsx scripts/typecheck-fixtures.ts",
    "certify": "npm run build && npm run lint && npm run typecheck && npm run version:check && npm run enterprise:threat-model && npm run claims:check && npm run m26:integrity && npm run coverage:exemptions && npm run candidate:manifest:check && npm run candidate:decision:engineering && npm run docs:translations && npm run test && npx vitest run tests/contract/",
    "certify:ci": "npm run build && npm run lint && npm run typecheck && npm run version:check && npm run enterprise:threat-model && npm run claims:check && npm run m26:integrity && npm run coverage:exemptions && npm run candidate:manifest:check && npm run candidate:decision:engineering && npm run docs:translations && npm run test:coverage:ci && npx vitest run tests/contract/",
    "ci-local": "npm run certify:ci && npm run test:property && npm run test:fuzz && npm run coverage:ratchet && npm run audit:ci && npm run brand:doctor && npm run brand:doctor:selftest && npm run brand:fonts:check && npm run site:doctor && npm run ci-local:parity",
    "verify:isolation": "node scripts/verify-remediation-isolation.mjs",
    "golden:update": "tsx tests/golden/gen.ts",
    "detector-hashes:update": "tsx scripts/generate-detector-hashes.ts",
    "corpus:regression": "tsx tests/corpus/audit.ts",
    "corpus:regression:update": "tsx tests/corpus/audit.ts --update",
    "corpus:regression:refresh-provenance": "tsx tests/corpus/audit.ts --refresh-provenance",
    "corpus:sample": "tsx scripts/corpus-sample.ts",
    "fp-audit:generate": "tsx scripts/generate-fp-audit-table.ts",
    "docs:rules": "tsx scripts/generate-rule-docs.ts",
    "docs:counts": "tsx scripts/generate-counts.ts",
    "docs:depth-adjudication": "tsx scripts/generate-depth-adjudication.ts",
    "false-green:index": "tsx scripts/generate-false-green-index.ts",
    "docs:capabilities-playwright": "tsx scripts/generate-playwright-capabilities.ts",
    "docs:blast-radius": "tsx scripts/generate-blast-radius.ts",
    "docs:quarantine-ledger": "tsx scripts/generate-quarantine-ledger.ts",
    "docs:capability": "tsx scripts/generate-capability-matrix.ts",
    "docs:machine-contract": "tsx scripts/generate-machine-contract-doc.ts",
    "docs:hero": "tsx scripts/generate-readme-hero.ts",
    "docs:gauge": "tsx scripts/generate-readme-score-gauge.ts",
    "docs:readme-brand": "tsx scripts/generate-readme-brand.ts",
    "docs:formats": "tsx scripts/generate-site-formats.ts",
    "docs:forensics-samples": "tsx scripts/generate-forensics-samples.ts",
    "site:doctor": "npm --prefix site run doctor",
    "site:audit": "node site/scripts/audit-live.mjs",
    "site:lighthouse": "node site/scripts/lighthouse-run.mjs",
    "docs:demo": "tsx scripts/generate-readme-demo.ts",
    "docs:video:capture": "tsx scripts/video/write-scripts.ts",
    "docs:video:glyphs": "tsx scripts/video/check-glyphs.ts",
    "docs:video:render": "tsx scripts/video/render.ts",
    "docs:video": "npm run docs:video:capture && npm run docs:video:render",
    "docs:translations": "node scripts/check-readme-translations.mjs",
    "docs:translations:sync": "node scripts/sync-readme-release-status.mjs",
    "docs:translations:check": "node scripts/check-readme-translations.mjs --strict",
    "rules:census": "tsx scripts/print-rule-census.ts",
    "docs:roadmap:check": "tsx scripts/roadmap/check.ts",
    "docs:roadmap:backlinks": "tsx scripts/roadmap/check-backlinks.ts",
    "release:decision": "tsx scripts/release-decision.ts",
    "m26:audit": "tsx scripts/check-m26-ledgers.ts --stage readiness",
    "m26:integrity": "tsx scripts/check-m26-ledgers.ts --stage integrity",
    "m26:readiness": "npm run m26:audit && npm run candidate:readiness",
    "m26:github:sync": "node scripts/sync-m26-github.mjs",
    "changelog:check": "tsx scripts/check-changelog.ts",
    "reporter:version-check": "tsx scripts/check-reporter-version.ts",
    "version:surface:check": "tsx scripts/check-version-surface.ts",
    "version:surface:sync": "tsx scripts/sync-version-surface.ts",
    "version:check": "npm run version:surface:check && npm run reporter:version-check && npm run changelog:check",
    "release:verify": "npm run m26:audit && npm run version:check && npm run claims:check && npm run candidate:manifest:check && npm run candidate:decision:release && npm run candidate:readiness && npm run coverage:exemptions && npm run docs:roadmap:check && npm run enterprise:threat-model",
    "self-scan": "node dist/cli.mjs .",
    "ci-local:parity": "node scripts/check-ci-local-parity.mjs",
    "ci:standard": "node scripts/check-ci-standard.mjs",
    "test:property": "node scripts/check-property-runs.mjs && vitest run --config vitest.property.config.ts",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "docs:architecture": "tsx scripts/generate-readme-architecture.ts",
    "brand:tokens": "tsx scripts/generate-brand-tokens.ts",
    "brand:doctor": "node scripts/brand-doctor.mjs",
    "brand:doctor:selftest": "node scripts/brand-doctor-selftest.mjs",
    "brand:fonts": "tsx scripts/vendor-fonts.ts",
    "brand:fonts:check": "tsx scripts/vendor-fonts.ts --check",
    "brand:marks": "tsx scripts/generate-brand-marks.ts",
    "brand:marks:update": "node scripts/update-mark-hashes.mjs",
    "docs:regen": "npm run docs:rules && npm run fp-audit:generate && npm run docs:capability && npm run docs:counts && npm run docs:depth-adjudication && npm run docs:machine-contract && npm run brand:tokens && npm run golden:update && npm run docs:hero && npm run docs:demo && npm run docs:readme-brand && npm run detector-hashes:update"
  },
  "keywords": [
    "qa",
    "testing",
    "ci",
    "github-actions",
    "jest",
    "vitest",
    "playwright",
    "code-quality",
    "linter",
    "static-analysis"
  ],
  "author": "Mjölnir Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergey-Bar/Mjolnir.git"
  },
  "bugs": {
    "url": "https://github.com/Sergey-Bar/Mjolnir/issues"
  },
  "homepage": "https://github.com/Sergey-Bar/Mjolnir#readme",
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "0.25.6",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.3.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@vitest/coverage-istanbul@5.0.1": true
  }
}
